{
  "component_id": "read-pileup",
  "claim": "Observed BAM reads align at one SNV, whose illustrative ref and alt bases provide REF, ALT, and total read counts.",
  "semantic_contract": {
    "position": "The illustrative ref/alt label sits above the coordinate ruler; each base glyph remains centered on its read at the shared SNV locus.",
    "color": "Base identity uses the conventional hue families A=green, C=blue, G=orange, T=red. Dark foreground glyphs improve contrast against the neutral gray base tile; color does not encode REF or ALT status.",
    "count": "Five read rows encode REF=3 and ALT=2; the count panel derives REF reads, ALT reads, and total reads = REF + ALT from the same read groups.",
    "terminology_boundary": "G/A are illustrative ref/alt bases that identify the example pileup only; they are not source-data values."
  },
  "base_palette": {
    "A": "#00441B",
    "C": "#003380",
    "G": "#682600",
    "T": "#800000"
  },
  "asset_map": [
    {"role":"read backbone","path":"assets/raw_png/read_backbone.PNG","transform":"repeated unchanged"},
    {"role":"base identity glyph tiles","path":"assets/raw_png/{A,C,G,T}_base.PNG","transform":"re-rendered with the declared high-contrast foreground palette"}
  ],
  "canvas": {"width": 1200, "height": 460, "background": "#ffffff"},
  "quantities": [{"id":"alt-count","numerator_group":"alt-read","denominator_groups":["ref-read","alt-read"],"expected":0.4,"label_element":"total-reads-label"}],
