{
  "component_id": "snv-identity-igv-reads",
  "claim": "An IGV-style read stack locates one illustrative canonical SNV record at a shared genomic coordinate; only the focal base distinguishes REF from ALT support.",
  "semantic_contract": {
    "position": "All alignment blocks share a local chr1 coordinate ruler. The vertical purple guide is the illustrative one-based SNV position, 123,456,789; every allele tile is centered on that guide.",
    "color": "Neutral gray marks aligned read blocks. Orange G and green A identify the illustrative REF and ALT base calls at the focal locus only; colors do not encode clone, strand, haplotype, quality, or read count.",
    "count": "Five rows are a quantitative illustrative pileup: REF reads = 3, ALT reads = 2, total reads = 3 + 2 = 5, and illustrative ALT fraction = 2 / 5 = 40%. The vertical stacking is only non-overlap packing.",
    "terminology_boundary": "This is an explanatory mockup, not a BAM rendering: read starts/ends, row order, color intensity, and the five displayed reads must not be interpreted as a measured coverage or mapping-quality display."
  },
  "asset_map": [],
  "canvas": {"width": 1200, "height": 560, "background": "#ffffff"},
  "minimum_gap": 8,
  "quantities": [
    {"id": "alt-fraction", "numerator_group": "alt-read", "denominator_groups": ["ref-read", "alt-read"], "expected": 0.4, "label_element": "read-summary", "template": "REF = {complement:.0f}  ·  ALT = {numerator:.0f}  ·  total = {denominator:.0f}  ·  ALT fraction = {percent:.0f}%"}
  ],
  "allowed_overlaps": [["snv-guide", "read-1"], ["snv-guide", "read-2"], ["snv-guide", "read-3"], ["snv-guide", "read-4"], ["snv-guide", "read-5"], ["tick-snv", "coord-snv"], ["coord-snv", "snv-guide"], ["snv-guide", "base-1-label"], ["snv-guide", "base-2-label"], ["snv-guide", "base-3-label"], ["snv-guide", "base-4-label"], ["snv-guide", "base-5-label"]],
