{
  "component_id": "model-process-composite",
  "claim": "候選演化樹狀態與 canonical SNV row 共同經由 CCF、purity、CN、multiplicity 與 read evidence 評分，形成候選樹 posterior。",
  "canvas": {
    "width": 1024,
    "height": 1835,
    "background": "#ffffff"
  },
  "minimum_gap": 8,
  "quantities": [
    {
      "id": "xi_expected_alt_probability",
      "value": 0.42,
      "expected": 0.42,
      "label_element": "xi-value",
      "length_contracts": [
        {
          "element": "xi-bar-fill",
          "field": "width",
          "scale": 540,
          "factor": "value",
          "tolerance": 0.001
        }
      ]
    }
  ],
  "external_references": [
    {
      "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4359439/",
      "locator": "PhyloWGS Figure 1",
      "use": "vertical data-to-clonal-phylogeny staging; reference-only"
    },
    {
      "source": "https://www.nature.com/articles/s41467-023-40378-8",
      "locator": "COMPASS Figure 1",
      "use": "separate read/CN likelihood evidence blocks; reference-only"
    },
    {
      "source": "https://www.nature.com/articles/s41467-019-10737-5",
      "locator": "B-SCITE Figure 2",
      "use": "candidate-tree exploration and score endpoint; reference-only"
    }
  ],
  "semantic_contract": {
    "flow": "top-to-bottom stage ordering; arrows mean information passed to the next scoring stage",
    "feedback": "the final posterior is a candidate-tree score used by inference; it does not claim a one-way causal process or a unique true tree",
    "stage_1": "T is the fixed k=3 candidate tree topology, eta is clone-local fraction, and z assigns an SNV to a clone",
    "stage_2": "phi/CCF is cumulative prevalence: phi_v = eta_v + sum of descendant eta values",
    "stage_3": "ASCAT purity, local major/minor CN context, and model-generated multiplicity candidates jointly constrain the emission",
    "stage_4": "xi_i(g) is expected ALT probability for a genotype/multiplicity candidate, not observed VAF",
    "stage_5": "observed REF/ALT counts are compared with xi to obtain likelihood",
    "stage_6": "prior multiplied by likelihood yields a posterior score for the candidate tree"
  },
  "asset_map": {
    "T": "assets/components/fixed_k3_clone_tree.svg",
    "eta": "assets/components/eta_phi_tree.svg",
    "z": "assets/components/snv_assignment.svg",
    "multiplicity": "assets/png_to_svg/multiplicity.svg",
    "canonical_input": "assets/png_to_svg/canonical_snv_row.svg",
    "read_counts": "assets/components/read_pileup.svg",
    "purity": "assets/components/purity_mixture.svg",
    "cn_context": "assets/components/cn_segment_context.svg",
    "xi_likelihood_posterior": "compose primitives; no independent biological asset listed"
  },
